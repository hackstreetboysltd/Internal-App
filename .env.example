# Copy to .env.local for local dev. Never commit .env.local.

# --- App (server) ---
NODE_ENV=development
APP_URL=http://localhost:3000/Internal-App
NEXT_PUBLIC_BASE_PATH=/Internal-App
SESSION_TTL_SEC=604800
SESSION_COOKIE_NAME=sid
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_ROTATE_AFTER_SEC=86400

# --- Google OAuth (Phase 1+) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/Internal-App/api/auth/callback
GOOGLE_HD=

# --- PostgreSQL (local Docker or Neon pooled URI with ?sslmode=require) ---
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal
# Production (Neon): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=1
# DATABASE_SSL_REJECT_UNAUTHORIZED=0
# For `npm run db:copy` (Neon → local Docker):
# NEON_DATABASE_URL=
# Large document blobs: local disk outside Vercel (default on). Set 0 to force Postgres bytea.
# DOCUMENT_FILES_DISK=1
# DOCUMENT_FILES_DIR=

# --- Redis (local Docker or Upstash rediss:// URI) ---
REDIS_URL=redis://localhost:6379
# Production (Upstash): rediss://default:TOKEN@HOST.upstash.io:6379

# Vercel Cron auth (set the same value in Vercel project env)
# CRON_SECRET=

# --- Rate limits (requests per minute) ---
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_SYNC_PER_MIN=30
RATE_LIMIT_ACTIVITY_PER_MIN=60
RATE_LIMIT_WRITE_PER_MIN=20

# --- Observability ---
API_LOG_RETENTION_DAYS=30
ACTIVITY_LOG_RETENTION_DAYS=90
SSE_BUFFER_SIZE=500
NEXT_PUBLIC_PORTAL_TZ=Africa/Nairobi

# --- GitHub connect only (Firebase Auth — not used for module data) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: Firestore → Postgres one-time migration (--live mode)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# --- EmailJS (client modules + server pending-user notify) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_PORTAL_URL=
# Optional server aliases (fall back to NEXT_PUBLIC_* if unset)
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
